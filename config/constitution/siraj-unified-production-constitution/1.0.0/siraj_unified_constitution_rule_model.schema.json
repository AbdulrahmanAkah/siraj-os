{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:siraj:constitution:rule-model-schema:1.0.0",
  "title": "SIRAJ Unified Constitution Rule Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "constitution",
    "precedence",
    "states",
    "rules",
    "approval_binding",
    "invalidation_events",
    "phase_boundary"
  ],
  "properties": {
    "$schema": {
      "const": "./siraj_unified_constitution_rule_model.schema.json"
    },
    "constitution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "bundle_id",
        "authority",
        "scope",
        "fail_closed",
        "consolidation_status",
        "implementation_status",
        "production_authorized"
      ],
      "properties": {
        "id": { "const": "SIRAJ_UNIFIED_PRODUCTION_CONSTITUTION" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "bundle_id": { "type": "string", "minLength": 1 },
        "authority": { "const": "SYSTEM_ROOT" },
        "scope": { "const": "SERIES_WIDE" },
        "fail_closed": { "const": true },
        "consolidation_status": { "enum": ["COMPLETE", "INCOMPLETE"] },
        "implementation_status": { "enum": ["NOT_STARTED", "IN_PROGRESS", "VERIFIED"] },
        "production_authorized": { "type": "boolean" }
      }
    },
    "precedence": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_results", "submission_states"],
      "properties": {
        "gate_results": {
          "type": "array",
          "const": ["PASS", "FAIL", "BLOCKED"]
        },
        "submission_states": {
          "type": "array",
          "minItems": 9,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "approval_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_fields", "material_change_invalidates"],
      "properties": {
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "material_change_invalidates": { "const": true }
      }
    },
    "invalidation_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "invalidates"],
        "properties": {
          "event": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "invalidates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          }
        }
      }
    },
    "phase_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "section",
        "title",
        "severity",
        "scope",
        "norm",
        "value",
        "fail_closed",
        "compiler",
        "validators",
        "tests",
        "runtime_gates",
        "failure_codes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^SIRAJ\\.S(0[1-9]|10)\\.[A-Z0-9_]+$" },
        "section": { "type": "integer", "minimum": 1, "maximum": 10 },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
        "scope": { "enum": ["SERIES_WIDE", "EPISODE", "ASSET", "ATTEMPT", "PUBLICATION"] },
        "norm": { "enum": ["REQUIRED", "FORBIDDEN", "ALLOWED", "DYNAMIC", "INVARIANT"] },
        "value": {},
        "fail_closed": { "type": "boolean" },
        "compiler": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applies", "obligations"],
          "properties": {
            "applies": { "type": "boolean" },
            "obligations": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "validators": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tests": {
          "type": "array",
          "items": { "type": "string" }
        },
        "runtime_gates": {
          "type": "array",
          "items": { "type": "string" }
        },
        "failure_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^FAIL_[A-Z0-9_]+$" }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "invalidates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
